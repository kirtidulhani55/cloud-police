# Required at frontend build time. Use the restricted Identity Platform Web API key.
VITE_IDENTITY_PLATFORM_API_KEY="PASTE_RESTRICTED_WEB_API_KEY_HERE"

# Cloud Police APIs. These defaults match the current us-east1 deployment.
VITE_CLOUD_POLICE_API_URL="https://cloud-police-dashboard-api-794315906908.us-east1.run.app"
VITE_CLOUD_POLICE_APPROVAL_API_URL="https://cloud-police-approval-api-794315906908.us-east1.run.app"

# Local Vite uses this file. In Cloud Run, set the same three names as runtime
# environment variables; server.js provides them through /runtime-config.js.
# Never copy .env.local into the container image.
